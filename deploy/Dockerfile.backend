# Builds and runs the .NET 10 backend (Web API + SignalR). FluentMigrator runs
# migrations automatically on startup, so no separate migration step is needed on Railway.

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY backend/*.sln* .
COPY backend/Api/*.csproj Api/
COPY backend/Domain/*.csproj Domain/
COPY backend/Infrastructure/*.csproj Infrastructure/
RUN dotnet restore LolStatTrak.slnx

COPY backend/ .
RUN dotnet publish Api/LolStatTrak.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

# Railway sets PORT; ASP.NET Core listens on it via ASPNETCORE_URLS.
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "LolStatTrak.Api.dll"]
