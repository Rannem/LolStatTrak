# Builds the Angular app and serves it (plus reverse-proxies to the backend) via Caddy.
# Caddy is the only public entrypoint; /api and /hubs are proxied to the backend over
# Railway's private network, so API traffic never leaves the internal network.

FROM node:22-alpine AS build
WORKDIR /src
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npx ng build --configuration production

FROM caddy:2-alpine AS runtime
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/dist/frontend/browser /srv

EXPOSE 8080
