{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "ddragon-images",
      "urls": ["https://ddragon.leagueoflegends.com/cdn/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 400,
        "maxAge": "30d"
      }
    },
    {
      "name": "discord-avatars",
      "urls": ["https://cdn.discordapp.com/avatars/**", "https://cdn.discordapp.com/embed/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 100,
        "maxAge": "7d"
      }
    },
    {
      "name": "champion-catalog",
      "urls": ["/api/champions"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 1,
        "maxAge": "1h",
        "timeout": "2s"
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/api/**", "!/hubs/**"]
}
